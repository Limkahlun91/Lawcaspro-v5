{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/lawcaspro/dist/public",
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/payment-voucher-sla",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/case-bottlenecks",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/notification-digest",
      "schedule": "15 * * * *"
    }
  ]
}
